# MongoDB Atlas connection string (include /loqit database name or set MONGO_DB)
MONGO_URI=
MONGO_DB=loqit

# Supabase project — used ONLY to verify auth JWTs (auth stays on Supabase)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Legacy HS256 JWT secret (Supabase Dashboard > Settings > API > JWT Secret).
# If your project uses the new asymmetric signing keys, leave this empty —
# the server will verify against the project's JWKS endpoint instead.
SUPABASE_JWT_SECRET=

# Secret used for deterministic LOQIT key generation (same as the old
# Supabase edge function's APP_SECRET so regenerated keys stay identical)
APP_SECRET=

# Only needed by scripts/migrate.js to export data out of Supabase
SUPABASE_SERVICE_ROLE_KEY=

PORT=4000
# Comma-separated allowed origins for CORS/Socket.io ("*" for development)
CORS_ORIGINS=*
