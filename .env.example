# Copy this file to `.env` and fill in real values. NEVER commit real secrets.
# `.env` is gitignored; this `.env.example` must contain placeholders only.
#
# Auth and data both run on the LOQIT API (server/) backed by MongoDB.
# Supabase is no longer used anywhere.

# ── Public client vars (safe to ship in the app bundle) ──────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
EXPO_PUBLIC_LOCATIONIQ_API_KEY=your-locationiq-api-key

# LOQIT API base URL. Must be reachable FROM THE PHONE — a LAN IP such as
# http://192.168.1.5:4000 for local testing, or the deployed URL for APK builds.
# localhost only works for the web app and the Android emulator (10.0.2.2).
EXPO_PUBLIC_API_URL=https://loqit-api.onrender.com

# ── server/.env (never bundled into the app) ─────────────────────────────────
# MONGO_URI=mongodb://user:pass@host:27017/?directConnection=true
# MONGO_DB=loqit
# PORT=4000
# CORS_ORIGINS=http://localhost:5173
#
# Signs LOQIT access tokens. At least 32 characters, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every user out.
# JWT_SECRET=your-long-random-secret
#
# Google OAuth. ONE web client covers web AND Android — the app opens a browser
# pointed at this server, so Google never talks to the APK directly and no
# separate Android client id is needed.
# In Google Cloud Console the authorized redirect URI must be exactly:
#   <PUBLIC_API_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=your-google-web-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-web-oauth-client-secret
#
# Public origin of this API, used to build the Google redirect URI.
# PUBLIC_API_URL=http://localhost:4000
#
# Where users land after signing in, when the client does not specify.
# DEFAULT_REDIRECT_TO=http://localhost:5173/auth/callback
#
# Optional webhook that emails password-reset links. Without it the link is
# printed to the server log instead.
# N8N_RESET_EMAIL_URL=

# ── web/.env ─────────────────────────────────────────────────────────────────
# VITE_API_URL=http://localhost:4000
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# VITE_LOCATIONIQ_API_KEY=your-locationiq-api-key
# VITE_GROQ_API_KEY=your-groq-api-key   # police chat analysis
