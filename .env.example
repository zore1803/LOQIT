# Copy this file to `.env` and fill in real values. NEVER commit real secrets.
# `.env` is gitignored; this `.env.example` must contain placeholders only.

# ── Public client vars (safe to ship in the app bundle) ──────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
EXPO_PUBLIC_LOCATIONIQ_API_KEY=your-locationiq-api-key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-oauth-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-oauth-client-id

# ── Private / admin vars (server & CLI only — must NOT appear in app code) ────
SUPABASE_PROJECT_ID=your-supabase-project-ref
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token

# LOQIT API (MongoDB backend) base URL — device-reachable LAN IP or deployed URL for APK builds
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
